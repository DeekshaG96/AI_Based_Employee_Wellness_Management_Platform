FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NLTK_DATA=/usr/local/share/nltk_data \
    HF_HOME=/var/cache/huggingface

WORKDIR /app
COPY requirements-api.txt ./requirements-api.txt
RUN pip install --no-cache-dir --index-url https://pypi.org/simple --extra-index-url https://download.pytorch.org/whl/cpu "torch==2.14.1+cpu" \
    && pip install --no-cache-dir -r requirements-api.txt \
    && python -m spacy download en_core_web_sm \
    && python -m nltk.downloader --extract -d "$NLTK_DATA" stopwords wordnet omw-1.4 punkt punkt_tab averaged_perceptron_tagger_eng vader_lexicon
RUN chmod -R a+rX "$NLTK_DATA"

COPY wellness ./wellness
COPY wellness_api ./wellness_api
RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /var/cache/huggingface \
    && chown -R appuser:appuser /app /var/cache/huggingface
USER appuser

EXPOSE 8000
CMD ["uvicorn", "wellness_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
